/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self' https:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

/registry.json
  Access-Control-Allow-Origin: *
  Cache-Control: no-cache

/deedlog.js
  Access-Control-Allow-Origin: *
